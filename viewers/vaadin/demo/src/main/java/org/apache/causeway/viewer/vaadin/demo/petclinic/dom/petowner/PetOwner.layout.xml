<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Ported from apache/causeway-app-petclinic (module-petowner) — trimmed of the
  Content/attachment fieldset (Blob upload isn't part of this ported subset;
  it's already exercised elsewhere in this demo).
-->
<bs3:grid
        xsi:schemaLocation="https://causeway.apache.org/applib/layout/component https://causeway.apache.org/applib/layout/component/component.xsd https://causeway.apache.org/applib/layout/grid/bootstrap3 https://causeway.apache.org/applib/layout/grid/bootstrap3/bootstrap3.xsd"
        xmlns:cpt="https://causeway.apache.org/applib/layout/component"
        xmlns:bs3="https://causeway.apache.org/applib/layout/grid/bootstrap3"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <bs3:row>
        <bs3:col span="12" unreferencedActions="true">
            <cpt:domainObject bookmarking="AS_ROOT"/>
        </bs3:col>
    </bs3:row>
    <bs3:row>
        <bs3:col span="6">
            <bs3:row>
                <bs3:col span="12">
                    <bs3:tabGroup>
                        <bs3:tab name="Identity">
                            <bs3:row>
                                <bs3:col span="12">
                                    <cpt:fieldSet name="Identity" id="identity">
                                        <cpt:action id="delete" position="PANEL"/>
                                        <cpt:property id="name">
                                            <cpt:action id="updateName"/>
                                        </cpt:property>
                                        <cpt:property id="knownAs"/>
                                    </cpt:fieldSet>
                                </bs3:col>
                            </bs3:row>
                        </bs3:tab>
                        <bs3:tab name="Other">
                            <bs3:row>
                                <bs3:col span="12">
                                    <cpt:fieldSet name="Other" id="other" unreferencedProperties="true"/>
                                </bs3:col>
                            </bs3:row>
                        </bs3:tab>
                        <bs3:tab name="Metadata">
                            <bs3:row>
                                <bs3:col span="12">
                                    <cpt:fieldSet name="Metadata" id="metadata">
                                        <cpt:property id="version"/>
                                    </cpt:fieldSet>
                                </bs3:col>
                            </bs3:row>
                        </bs3:tab>
                    </bs3:tabGroup>
                </bs3:col>
                <bs3:col span="12">
                    <cpt:fieldSet name="Contact" id="contact">
                        <cpt:property id="telephoneNumber"/>
                        <cpt:property id="emailAddress"/>
                    </cpt:fieldSet>
                </bs3:col>
                <bs3:col span="12">
                    <cpt:fieldSet name="Details" id="details">
                        <cpt:property id="notes"/>
                        <cpt:property id="lastVisit"/>
                        <cpt:property id="daysSinceLastVisit"/>
                    </cpt:fieldSet>
                </bs3:col>
            </bs3:row>
        </bs3:col>
        <bs3:col span="6">
            <bs3:row>
                <bs3:col span="12">
                    <bs3:row>
                        <bs3:col span="12">
                            <cpt:collection id="pets"/>
                        </bs3:col>
                    </bs3:row>
                    <bs3:row>
                        <bs3:col span="12">
                            <cpt:collection id="visits"/>
                        </bs3:col>
                    </bs3:row>
                </bs3:col>
            </bs3:row>
            <!-- required even though pets/visits are both already placed explicitly
                 above: Causeway's grid validation (GridServiceDefault) rejects a
                 layout.xml with no column and no unreferencedCollections tabgroup at
                 all ("no safety net for any collection the layout doesn't name"),
                 falling back to the auto-generated grid for the whole page — removing
                 this as "dead weight" (an earlier pass here did exactly that) silently
                 breaks the entire custom layout, not just this one empty tab strip.
                 Confirmed by GridServiceDefault's own error: "No column and also no
                 tabgroup found with the 'unreferencedCollections' attribute set". -->
            <bs3:tabGroup unreferencedCollections="true">
            </bs3:tabGroup>
        </bs3:col>
    </bs3:row>
</bs3:grid>
